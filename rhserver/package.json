{
  "name": "rhserver",
  "version": "1.0.0",
  "description": "Rich Harbor admin backend — Blogs, Leads, Marketing (Express 5 + Sequelize 6 + Postgres, schema-parameterized)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:prepare": "node scripts/ensure-schema.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:migrate:rfin": "sequelize-cli db:migrate --config config/rfin.config.js --migrations-path migrations/rfin",
    "db:migrate:rfin:undo": "sequelize-cli db:migrate:undo --config config/rfin.config.js --migrations-path migrations/rfin",
    "db:seed:rfin": "sequelize-cli db:seed:all --config config/rfin.config.js --seeders-path seeders/rfin"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.45",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "ulid": "^2.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.2"
  }
}
